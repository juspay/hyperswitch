# Supply the real hash and service credentials at runtime. Never commit .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ORIGIN=http://127.0.0.1:4174
ROUTER_ADMIN_API_KEY=
SUPERPOSITION_TOKEN=
# Optional. The console also checks the source build and PATH.
K6_BINARY=
GRAFANA_URL=http://127.0.0.1:3002
# Use a Grafana Viewer identity. Auth proxy mode is needed by some embedded dashboards.
GRAFANA_TOKEN=
GRAFANA_USER=
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=hyperswitch_db
# Set an existing account; the console never creates PostgreSQL roles.
PGUSER=
PGPASSWORD=
# Optional private CA for npm run dev:tls / start:tls. Must be an absolute PEM path.
PGSSLROOTCERT=

# Optional server-only target JSON. Empty means simulation only.
LOADTEST_FAULT_TARGETS=
# Remote workers enroll once with this token, then receive a unique credential.
LOADTEST_WORKER_ENROLLMENT_TOKEN=replace-with-a-long-random-token
# LOADTEST_CONTROL_PLANE_URL=https://loadtest.example.com
# LOADTEST_WORKER_NAME=worker-1
# LOADTEST_WORKER_TPS=250
# LOADTEST_WORKER_VUS=2500
# LOADTEST_WORKER_POLL_MS=1000
