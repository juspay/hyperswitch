{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "moduleResolution": "bundler",
    "target": "ES2022",
    "strict": false
  },
  "include": [
    "src/**/*.js",
    "src/**/*.svelte",
    "vite.config.js"
  ],
  "exclude": [
    "node_modules",
    "src/service-worker"
  ]
}
