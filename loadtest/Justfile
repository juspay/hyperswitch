set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

deploy action *services:
    ./deploy/bin/deploy.sh {{action}} {{services}}

deploy-preflight:
    just deploy preflight

deploy-repos:
    just deploy repos

deploy-build *services:
    just deploy build {{services}}

deploy-prepare:
    just deploy prepare

deploy-up-state:
    just deploy up-state

deploy-init-state:
    just deploy init-state

deploy-up-apps *services:
    just deploy up-apps {{services}}

deploy-up-observability:
    just deploy up-observability

deploy-up:
    just deploy up

deploy-ready:
    just deploy ready

deploy-down:
    just deploy down

deploy-reset:
    just deploy reset-state

deploy-restart *services:
    just deploy restart {{services}}

deploy-status:
    just deploy status

deploy-logs service:
    just deploy logs {{service}}

deploy-observability-logs:
    just deploy observability-logs

deploy-restart-observability:
    just deploy up-observability

deploy-log-paths:
    just deploy log-paths

runner action *args:
    ./runner/bin/runner.sh {{action}} {{args}}

runner-preflight:
    just runner preflight

runner-fixtures:
    just runner fixtures

runner-discard:
    just runner discard-fixtures

runner-start:
    just runner start

runner-status:
    just runner status

modular-cit-off-session action *args:
    CONFIG=runner/config.local.modular_cit_off_session.yaml K6_BIN=runner/bin/k6-docker.sh just runner {{action}} {{args}}

modular-cit-off-session-prepare:
    just modular-cit-off-session discard-fixtures
    just modular-cit-off-session preflight
    ./deploy/bin/unlock-vault.sh
    just modular-cit-off-session fixtures
    CONTAINER_RUNTIME=docker CONFIG=deploy/config.docker-hub.yaml just deploy restart dummy-connector

modular-cit-off-session-start:
    just modular-cit-off-session start

modular-cit-off-session-status:
    just modular-cit-off-session status

runner-test:
    node --test runner/test/*.test.js

cpu-plan:
    node cpu/bin/cpu.js plan

cpu-show:
    node cpu/bin/cpu.js show

cpu-apply:
    ./deploy/generated/cpu/apply.sh

cpu-verify:
    ./deploy/generated/cpu/verify.sh

cpu-rollback:
    ./deploy/generated/cpu/rollback.sh

cpu-test:
    node --test cpu/test/*.test.js

smoke merchant_path="non_modular" scenario="cit_off_session":
    CONFIG=runner/config.smoke.yaml just runner smoke {{merchant_path}} {{scenario}}

e2e-smoke:
    just deploy-down
    just deploy-ready
    just runner-test
    just smoke non_modular guest
    just smoke non_modular cit_on_session
    just smoke non_modular cit_off_session
    just smoke non_modular cit_metadata_changed
    just smoke modular guest
    just smoke modular cit_on_session
    just smoke modular cit_off_session
