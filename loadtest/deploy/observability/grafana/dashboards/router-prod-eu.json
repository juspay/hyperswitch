{
  "uid": "hs-router-pm-metrics",
  "title": "Router <> PM metrics",
  "description": "Router and Payment Method Modular load-test dashboard for the prod EU environment. There is no standalone encryption service in this environment; PAYMENT_METHOD_CRYPTO_DURATION represents cryptographic work observed inside the PM service.",
  "tags": [
    "hyperswitch",
    "prod",
    "eu",
    "modular",
    "loadtest"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 3,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/^VictoriaMetrics$/",
        "refresh": 1,
        "hide": 0,
        "options": [],
        "current": {}
      },
      {
        "name": "router_deployment",
        "label": "Router deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kube_deployment_status_replicas{namespace=\"hyperswitch\", deployment=\"hyperswitch-router-hyperswitch-server\"}, deployment)",
        "definition": "label_values(kube_deployment_status_replicas{namespace=\"hyperswitch\", deployment=\"hyperswitch-router-hyperswitch-server\"}, deployment)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "current": {}
      },
      {
        "name": "pm_deployment",
        "label": "PM application",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kube_deployment_status_replicas{namespace=\"hyperswitch\", deployment=~\"payment-method-modular-.*-hyperswitch-server\"}, deployment)",
        "definition": "label_values(kube_deployment_status_replicas{namespace=\"hyperswitch\", deployment=~\"payment-method-modular-.*-hyperswitch-server\"}, deployment)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "current": {}
      },
      {
        "name": "vault_deployment",
        "label": "Card Vault deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(kube_deployment_status_replicas{namespace=\"hyperswitch\", deployment=\"hyperswitch-card-vault-hyperswitch-card-vault\"}, deployment)",
        "definition": "label_values(kube_deployment_status_replicas{namespace=\"hyperswitch\", deployment=\"hyperswitch-card-vault-hyperswitch-card-vault\"}, deployment)",
        "refresh": 2,
        "sort": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "current": {}
      },
      {
        "name": "merchant_mode",
        "label": "Merchant mode",
        "type": "custom",
        "query": "modular,non_modular",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "options": [],
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "outcome",
        "label": "Router outcome",
        "type": "custom",
        "query": "success,failure",
        "hide": 0,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "options": [],
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "percentile",
        "label": "Percentile",
        "type": "custom",
        "query": "p50 : 0.50,p75 : 0.75,p90 : 0.90,p99 : 0.99",
        "hide": 0,
        "includeAll": false,
        "allValue": null,
        "multi": false,
        "options": [],
        "current": {
          "selected": true,
          "text": "p90",
          "value": "0.90"
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "type": "dashboard",
        "name": "Annotations & Alerts",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Router payment-confirm overview",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Payment-confirm latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "pointSize": 5
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(${percentile:raw}, sum by (le, merchant_mode) (rate(payment_operation_duration_seconds_bucket{source_namespace=\"hyperswitch\", source_pod=~\"${router_deployment:raw}-.*\", merchant_mode=~\"${merchant_mode:regex}\", outcome=~\"${outcome:regex}\", operation=\"confirm\"}[$__rate_interval])))",
          "legendFormat": "{{merchant_mode}}",
          "editorMode": "code",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(${percentile:raw}, sum by (le) (rate(REQUEST_TIME_bucket{source_namespace=\"hyperswitch\", source_pod=~\"${router_deployment:raw}-.*\", path=\"/payments/{payment_id}/confirm\", method=\"POST\"}[$__rate_interval])))",
          "legendFormat": "Request Time",
          "editorMode": "code",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B"
        }
      ],
      "description": "Payment operation latency is the confirm-domain timer. Request Time is the end-to-end Router HTTP timer for POST /payments/{payment_id}/confirm."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Confirm traffic",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false,
            "axisSoftMin": 0,
            "pointSize": 5
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (merchant_mode, outcome) (rate(payment_operation_duration_seconds_count{source_namespace=\"hyperswitch\", source_pod=~\"${router_deployment:raw}-.*\", operation=\"confirm\", merchant_mode=~\"${merchant_mode:regex}\", outcome=~\"${outcome:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{merchant_mode}} / {{outcome}}",
          "editorMode": "code",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "row",
      "title": "Router component latency",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "panels": []
