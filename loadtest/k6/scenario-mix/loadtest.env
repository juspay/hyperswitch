# Load-test target + credentials, sourced by run-remote-loadtest.sh.
#
# SECURITY: this repo (juspay/hyperswitch) is public on GitHub, so API_KEY
# and PUBLISHABLE_KEY below are placeholders, NOT real values — fill them in
# on the remote box before running (they're never committed for real). See
# REMOTE_RUN.md step 3 ("Configure credentials").

ROUTER_URL=https://8.233.38.64.sslip.io
MODULAR_PM_URL=https://8.233.38.64.sslip.io/v1
API_KEY=REPLACE_WITH_MERCHANT_API_KEY
PUBLISHABLE_KEY=REPLACE_WITH_MERCHANT_PUBLISHABLE_KEY
PROFILE_ID=pro_t0aRIMXsJemyiUixqE6d
# Not read by the script itself (scenario-mix.js auths via api_key/profile_id
# only) — kept here for reference/traceability of which merchant this is.
MERCHANT_ID=merchant_1789504069

# Ramp shape: staircase from STARTING_RPS to TARGET_RPS in STEP_RPS
# increments, holding each step for HOLD_SECONDS with an IDLE_SECONDS gap
# between steps. See loadtest/k6/scenario-mix/README.md "Finding maximum RPS".
STARTING_RPS=30
TARGET_RPS=1200
STEP_RPS=50
HOLD_SECONDS=30
IDLE_SECONDS=5

# Traffic mix weights — must sum to 100. guest = plain non-modular checkout;
# modular_cit_off = modular customer-initiated save-card (cit_off_session).
GUEST_WEIGHT=70
MODULAR_CIT_OFF_WEIGHT=30
