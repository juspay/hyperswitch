# Sustained (non-stopping) load for a failover/recovery drill, sourced by
# run-failover-loadtest.sh.
#
# Unlike the ramp runbook (loadtest.env / run-remote-loadtest.sh), this keeps
# generating steady traffic regardless of failure rate — there are no
# abortOnFail thresholds, so nothing stops the run when errors spike. That's
# the point: trigger your failover mid-run, and the run keeps going through
# it so you can measure how long the application takes to recover.
#
# SECURITY: same as loadtest.env — this repo (juspay/hyperswitch) is public,
# so API_KEY/PUBLISHABLE_KEY are placeholders. Fill them in on the remote box
# only; never commit real values here. run-failover-loadtest.sh refuses to
# start against leftover placeholders.

ROUTER_URL=https://8.233.38.64.sslip.io
MODULAR_PM_URL=https://8.233.38.64.sslip.io/v1
API_KEY=REPLACE_WITH_MERCHANT_API_KEY
PUBLISHABLE_KEY=REPLACE_WITH_MERCHANT_PUBLISHABLE_KEY
PROFILE_ID=pro_t0aRIMXsJemyiUixqE6d
MERCHANT_ID=merchant_1789504069

# Steady iterations/second to hold for the whole run. Pick a rate you
# already know the app handles cleanly in steady state — this is a recovery
# drill, not a capacity ramp. 100 sits comfortably below the ~230 rps knee
# observed in the earlier staircase run against this target.
FLAT_RPS=100

# Total run length in seconds. Make this generously longer than however long
# you expect the failover + recovery window to take. The run does NOT stop
# on failures, so it's safe to run long and just kill it early once you've
# captured enough of the recovery (run-failover-loadtest.sh prints the kill
# command; the recovery report is generated automatically either way).
DURATION_SECONDS=3600

REQUEST_TIMEOUT_MS=30000

# Traffic mix weights — must sum to 100.
GUEST_WEIGHT=70
MODULAR_CIT_OFF_WEIGHT=30
