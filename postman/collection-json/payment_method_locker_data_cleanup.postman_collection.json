{
  "info": {
    "_postman_id": "f7157c8e-0b91-4c57-b06e-520986d548cb",
    "name": "Payment Method Locker Data Cleanup",
    "description": "Admin APIs for asynchronously clearing locker_fingerprint_id or locker_id from payment methods supplied in a CSV file.\n\nThe CSV must contain exactly one header named payment_method_id. Set deletion_type to locker_fingerprint_id or locker_id. The initiation request automatically saves the returned job_id as a collection variable for the status and failure-download requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "value",
        "value": "{{admin_api_key}}",
        "type": "string"
      },
      {
        "key": "key",
        "value": "api-key",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Initiate locker data cleanup",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cleanup job was initiated\", function () {",
              "    pm.response.to.have.status(200);",
              "    const response = pm.response.json();",
              "    pm.expect(response.status).to.eql(\"initiated\");",
              "    pm.expect(response.deletion_type).to.eql(pm.variables.get(\"deletion_type\"));",
              "    pm.expect(response.job_id).to.be.a(\"string\").and.not.empty;",
              "    pm.collectionVariables.set(\"job_id\", response.job_id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "deletion_type",
              "value": "{{deletion_type}}",
              "description": "Allowed values: locker_fingerprint_id or locker_id",
              "type": "text"
            },
            {
              "key": "file",
              "description": "CSV with one payment_method_id column. If Postman does not resolve the file-path variable, select the file manually.",
              "type": "file",
              "src": "{{csv_file_path}}"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/payment_methods/batch-deletion",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "payment_methods",
            "batch-deletion"
          ]
        },
        "description": "Queues the cleanup and immediately returns its job ID.\n\nFor deletion_type=locker_fingerprint_id, the field is cleared only when locker_id is null and payment_method_type is apple_pay or google_pay. For deletion_type=locker_id, locker_id is cleared for every matching payment method without additional eligibility checks."
      },
      "response": []
    },
    {
      "name": "2. Retrieve cleanup status",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Cleanup status was returned\", function () {",
              "    pm.response.to.have.status(200);",
              "    const response = pm.response.json();",
              "    pm.expect(response.job_id).to.eql(pm.variables.get(\"job_id\"));",
              "    pm.expect(response.deletion_type).to.be.oneOf([\"locker_fingerprint_id\", \"locker_id\"]);",
              "    pm.expect(response.status).to.be.oneOf([\"initiated\", \"processing\", \"completed\", \"failed\"]);",
              "    pm.expect(response.processed_ids).to.be.a(\"number\");",
              "    pm.expect(response.successful_ids).to.be.a(\"number\");",
              "    pm.expect(response.failed_ids).to.be.a(\"number\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/payment_methods/batch-deletion/{{job_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "payment_methods",
            "batch-deletion",
            "{{job_id}}"
          ]
        },
        "description": "Returns the current job state and the total, processed, successful, and failed ID counts."
      },
      "response": []
    },
    {
      "name": "3. Download failed payment methods CSV",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Failure CSV was returned\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/csv\");",
              "    pm.expect(pm.response.text()).to.match(/^payment_method_id,failure_reason/);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "text/csv",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{base_url}}/payment_methods/batch-deletion/{{job_id}}/failures",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "payment_methods",
            "batch-deletion",
            "{{job_id}}",
            "failures"
          ]
        },
        "description": "Downloads payment_method_id and failure_reason as CSV. Call this only after the status is completed or failed; otherwise the API returns HTTP 412."
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "admin_api_key",
      "value": "",
      "type": "string"
    },
    {
      "key": "deletion_type",
      "value": "locker_fingerprint_id",
      "type": "string"
    },
    {
      "key": "csv_file_path",
      "value": "/absolute/path/to/payment_method_ids.csv",
      "type": "string"
    },
    {
      "key": "job_id",
      "value": "",
      "type": "string"
    }
  ]
}
